    "def time_grid(T, dt):\n",
    "    n = int(round(T / dt))\n",
    "    if n < 1 or not np.isclose(n * dt, T):\n",
    "        raise ValueError(\"T должно быть кратно dt\")\n",
    "    return np.arange(n + 1) * dt\n",
    "\n",
    "\n",
    "def simulate_wiener(T, dt, M, rng):\n",
    "    t = time_grid(T, dt)\n",
    "    dW = rng.normal(0.0, np.sqrt(dt), size=(M, t.size - 1))\n",
    "    W = np.zeros((M, t.size))\n",
    "    np.cumsum(dW, axis=1, out=W[:, 1:])\n",
    "    return t, W\n",
    "\n",
    "\n",
    "def simulate_poisson(T, dt, M, lam, rng):\n",
    "    t = time_grid(T, dt)\n",
    "    dN = rng.poisson(lam * dt, size=(M, t.size - 1))\n",
    "    N = np.zeros((M, t.size), dtype=np.int64)\n",
    "    np.cumsum(dN, axis=1, out=N[:, 1:])\n",
    "    return t, N\n",
    "\n",
    "\n",
    "def simulate_ou(T, dt, M, theta, mu, sigma, rng, x0=None):\n",
    "    t = time_grid(T, dt)\n",
    "    a = np.exp(-theta * dt)\n",
    "    s = np.sqrt(sigma**2 / (2 * theta) * (1 - a**2))\n",
    "    X = np.empty((M, t.size))\n",
    "    X[:, 0] = rng.normal(mu, sigma / np.sqrt(2 * theta), size=M) if x0 is None else x0\n",
    "    eta = rng.normal(0.0, s, size=(M, t.size - 1))\n",
    "    for k in range(t.size - 1):\n",
    "        X[:, k + 1] = mu + a * (X[:, k] - mu) + eta[:, k]\n",
    "    return t, X\n",
    "\n",
    "\n",
    "def ou_mean(t, theta, mu, x0):\n",
    "    t = np.asarray(t, dtype=float)\n",
    "    return np.full_like(t, mu) if x0 is None else mu + (x0 - mu) * np.exp(-theta * t)\n",
    "\n",
    "\n",
    "def ou_cov(s, t, theta, sigma, x0):\n",
    "    d = sigma**2 / (2 * theta)\n",
    "    K = d * np.exp(-theta * np.abs(np.subtract.outer(s, t)))\n",
    "    return K if x0 is None else K - d * np.exp(-theta * np.add.outer(s, t))\n",
    "\n",
    "\n",
    "def make_processes(lam, ou):\n",
    "    th, mu, sg, x0 = ou[\"theta\"], ou[\"mu\"], ou[\"sigma\"], ou[\"x0\"]\n",
    "    return {\n",
    "        \"Винер\": dict(\n",
    "            sim=lambda T, dt, M, rng: simulate_wiener(T, dt, M, rng),\n",
    "            mean=lambda t: np.zeros_like(t),\n",
    "            cov=lambda s, t: np.minimum.outer(s, t),\n",
    "        ),\n",
    "        \"Пуассон\": dict(\n",
    "            sim=lambda T, dt, M, rng: simulate_poisson(T, dt, M, lam, rng),\n",
    "            mean=lambda t: lam * t,\n",
    "            cov=lambda s, t: lam * np.minimum.outer(s, t),\n",
    "        ),\n",
    "        \"ОУ, X0 = x0\": dict(\n",
    "            sim=lambda T, dt, M, rng: simulate_ou(T, dt, M, th, mu, sg, rng, x0),\n",
    "            mean=lambda t: ou_mean(t, th, mu, x0),\n",
    "            cov=lambda s, t: ou_cov(s, t, th, sg, x0),\n",
    "        ),\n",
    "        \"ОУ, стац.\": dict(\n",
    "            sim=lambda T, dt, M, rng: simulate_ou(T, dt, M, th, mu, sg, rng, None),\n",
    "            mean=lambda t: ou_mean(t, th, mu, None),\n",
    "            cov=lambda s, t: ou_cov(s, t, th, sg, None),\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "def theory_var(p, t):\n",
    "    return np.diag(p[\"cov\"](t, t)).copy()\n",
    "\n",
    "\n",
    "PROC = make_processes(LAM, OU)\n",
    "COLORS = dict(zip(PROC, [\"C0\", \"C3\", \"C2\", \"C1\"]))"
   ]
  },
