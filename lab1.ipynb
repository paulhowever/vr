    "def sample_cov(V):\n",
    "    Vc = V - V.mean(axis=0)\n",
    "    return Vc.T @ Vc / (V.shape[0] - 1)\n",
    "\n",
    "\n",
    "def time_index(t, times):\n",
    "    idx = np.rint(np.asarray(times) / (t[1] - t[0])).astype(int)\n",
    "    assert np.allclose(t[idx], times)\n",
    "    return idx\n",
    "\n",
    "\n",
    "def rel_frob(K_hat, K):\n",
    "    return np.linalg.norm(K_hat - K) / np.linalg.norm(K)\n",
    "\n",
    "\n",
    "labels = [f\"{x:g}\" for x in COV_TIMES]\n",
    "fig, axes = plt.subplots(4, 3, figsize=(10.5, 13))\n",
    "rows = []\n",
    "for r, (name, (t, X)) in enumerate(ENS.items()):\n",
    "    K = PROC[name][\"cov\"](COV_TIMES, COV_TIMES)\n",
    "    K_hat = sample_cov(X[:, time_index(t, COV_TIMES)])\n",
    "    lo, hi = min(K.min(), K_hat.min()), max(K.max(), K_hat.max())\n",
    "    dmax = np.abs(K_hat - K).max()\n",
    "    for c, (mat, title, kw) in enumerate(\n",
    "        [\n",
    "            (K, \"K\", dict(cmap=\"viridis\", vmin=lo, vmax=hi)),\n",
