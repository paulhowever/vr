    "rows = []\n",
    "for name, p in INC_PROC.items():\n",
    "    for k, I in INTERVALS.items():\n",
    "        x, law = INC[name][k], p[\"law\"](length(I))\n",
    "        test, stat, pval = fit_test(x, law, name == \"Пуассон\")\n",
    "        rows.append(\n",
    "            {\n",
    "                \"процесс\": name,\n",
    "                \"интервал\": f\"{k} {list(I)}\",\n",
    "                \"h\": length(I),\n",
    "                \"среднее\": x.mean(),\n",
    "                \"теор. среднее\": law.mean(),\n",
    "                \"дисперсия\": x.var(ddof=1),\n",
    "                \"теор. дисперсия\": law.var(),\n",
    "                \"критерий\": test,\n",
    "                \"статистика\": stat,\n",
    "                \"p\": pval,\n",
    "            }\n",
    "        )\n",
    "display(pd.DataFrame(rows).set_index([\"процесс\", \"интервал\"]))\n",
    "\n",
    "fig, axes = plt.subplots(1, 4, figsize=(15, 3.3))\n",
    "for ax, k in zip(axes[:2], [\"A\", \"C\"]):\n",
    "    h, x = length(INTERVALS[k]), INC[\"Винер\"][k]\n",
    "    grid = np.linspace(-4 * np.sqrt(h), 4 * np.sqrt(h), 300)\n",
    "    ax.hist(x, bins=50, density=True, color=COLORS[\"Винер\"], alpha=0.5, label=\"эмпирика\")\n",
    "    ax.plot(grid, stats.norm(0, np.sqrt(h)).pdf(grid), \"k\", lw=1.2, label=f\"$\\\\mathcal{{N}}(0, {h:g})$\")\n",
    "    ax.set_title(f\"$W$, интервал {k}, h = {h:g}\")\n",
    "    ax.legend()\n",
    "for ax, k in zip(axes[2:], [\"A\", \"C\"]):\n",
    "    h, x = length(INTERVALS[k]), INC[\"Пуассон\"][k].astype(int)\n",
    "    vals = np.arange(0, x.max() + 1)\n",
    "    ax.bar(vals, np.bincount(x) / x.size, color=COLORS[\"Пуассон\"], alpha=0.5, label=\"эмпирика\")\n",
    "    ax.plot(vals, stats.poisson(LAM * h).pmf(vals), \"ko-\", ms=3, lw=1, label=f\"Pois({LAM * h:g})\")\n",
    "    ax.set_title(f\"$N$, интервал {k}, h = {h:g}\")\n",
