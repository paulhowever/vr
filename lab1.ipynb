    "INTERVALS = {\"A\": (1.0, 2.0), \"B\": (2.0, 3.0), \"C\": (4.0, 6.0), \"D\": (1.5, 2.5), \"E\": (1.0, 3.0)}\n",
    "PAIRS = [(\"A\", \"B\"), (\"A\", \"C\"), (\"A\", \"D\"), (\"A\", \"E\")]\n",
    "T_INC, M_INC, DT_INC = 6.0, 5000, 0.01\n",
    "DTS = [0.5, 0.1, 0.01, 0.002]\n",
    "\n",
    "INC_PROC = {\n",
    "    \"Винер\": dict(sim=lambda dt, rng: simulate_wiener(T_INC, dt, M_INC, rng), c=1.0, law=lambda h: stats.norm(0, np.sqrt(h))),\n",
    "    \"Пуассон\": dict(sim=lambda dt, rng: simulate_poisson(T_INC, dt, M_INC, LAM, rng), c=LAM, law=lambda h: stats.poisson(LAM * h)),\n",
    "}\n",
    "\n",
    "\n",
    "def length(I):\n",
    "    return I[1] - I[0]\n",
    "\n",
    "\n",
    "def overlap(I, J):\n",
    "    return max(0.0, min(I[1], J[1]) - max(I[0], J[0]))\n",
    "\n",
    "\n",
    "def increments(t, X):\n",
    "    out = {}\n",
    "    for k, (a, b) in INTERVALS.items():\n",
    "        ia, ib = time_index(t, [a, b])\n",
    "        out[k] = (X[:, ib] - X[:, ia]).astype(float)\n",
    "    return out\n",
    "\n",
    "\n",
    "def fit_test(x, law, discrete):\n",
    "    if not discrete:\n",
    "        res = stats.kstest(x, law.cdf)\n",
    "        return \"KS\", res.statistic, res.pvalue\n",
    "    K = 1\n",
    "    while x.size * law.sf(K) >= 5:\n",
    "        K += 1\n",
    "    obs = np.bincount(np.minimum(x.astype(int), K), minlength=K + 1)\n",
    "    exp = x.size * np.append(law.pmf(np.arange(K)), law.sf(K - 1))\n",
    "    res = stats.chisquare(obs, exp)\n",
    "    return \"χ²\", res.statistic, res.pvalue\n",
    "\n",
    "\n",
    "def qbin(x, k=5):\n",
    "    edges = np.unique(np.quantile(x, np.linspace(0, 1, k + 1)[1:-1]))\n",
    "    return np.searchsorted(edges, x, side=\"right\")\n",
    "\n",
    "\n",
    "def dependence(x, y):\n",
    "    r = np.corrcoef(x, y)[0, 1]\n",
    "    r_sq = np.corrcoef((x - x.mean()) ** 2, (y - y.mean()) ** 2)[0, 1]\n",
    "    tab = pd.crosstab(qbin(x), qbin(y)).to_numpy()\n",
    "    chi2, p, _, _ = stats.chi2_contingency(tab)\n",
    "    V = np.sqrt(chi2 / (x.size * (min(tab.shape) - 1)))\n",
    "    return r, r_sq, p, V\n",
    "\n",
    "\n",
    "INC = {}\n",
    "for j, (name, p) in enumerate(INC_PROC.items()):\n",
    "    t, X = p[\"sim\"](DT_INC, rng_for(4, j))\n",
    "    INC[name] = increments(t, X)"
   ]
