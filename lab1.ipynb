    "M_LIST = [10, 30, 100, 300, 1000]\n",
    "P_POOL, CHUNK = 40_000, 5000\n",
    "\n",
    "rows = []\n",
    "for a, th in enumerate(THETAS):\n",
    "    for b, Th in enumerate(HORIZONS):\n",
    "        for c, (init, x0) in enumerate(INITS.items()):\n",
    "            rng = rng_for(8, a, b, c)\n",
    "            xT, tav = [], []\n",
    "            for _ in range(P_POOL // CHUNK):\n",
    "                t, X = simulate_ou(Th, DT_OU, CHUNK, th, OU_P[\"mu\"], OU_P[\"sigma\"], rng, x0)\n",
    "                xT.append(X[:, -1])\n",
    "                tav.append(X[:, 1:].mean(axis=1))\n",
    "            xT, tav = np.concatenate(xT), np.concatenate(tav)\n",
    "            tk = t[1:]\n",
    "            bias_time = ou_mean(tk, th, OU_P[\"mu\"], x0).mean() - OU_P[\"mu\"]\n",
    "            var_time = ou_cov(tk, tk, th, OU_P[\"sigma\"], x0).mean()\n",
    "            bias_ens = ou_mean(t[-1:], th, OU_P[\"mu\"], x0)[0] - OU_P[\"mu\"]\n",
    "            var_ens1 = ou_cov(t[-1:], t[-1:], th, OU_P[\"sigma\"], x0)[0, 0]\n",
    "            for Mi in M_LIST:\n",
    "                g = xT[: (P_POOL // Mi) * Mi].reshape(-1, Mi).mean(axis=1)\n",
    "                rows.append(\n",
    "                    {\n",
    "                        \"θ\": th,\n",
    "                        \"T\": Th,\n",
    "                        \"начало\": init,\n",
    "                        \"M\": Mi,\n",
    "                        \"RMSE ens\": np.sqrt(np.mean((g - OU_P[\"mu\"]) ** 2)),\n",
    "                        \"RMSE ens теор.\": np.sqrt(bias_ens**2 + var_ens1 / Mi),\n",
    "                        \"RMSE time\": np.sqrt(np.mean((tav - OU_P[\"mu\"]) ** 2)),\n",
    "                        \"RMSE time теор.\": np.sqrt(bias_time**2 + var_time),\n",
    "                        \"смещение time\": tav.mean() - OU_P[\"mu\"],\n",
    "                        \"смещение time теор.\": bias_time,\n",
    "                    }\n",
    "                )\n",
    "MU_EST = pd.DataFrame(rows)\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 7), sharex=True)\n",
    "for r, th in enumerate(THETAS):\n",
    "    for c, Th in enumerate(HORIZONS):\n",
    "        ax = axes[r, c]\n",
    "        for init, col in zip(INITS, [\"C2\", \"C1\"]):\n",
    "            d = MU_EST[(MU_EST[\"θ\"] == th) & (MU_EST[\"T\"] == Th) & (MU_EST[\"начало\"] == init)]\n",
    "            ax.plot(d[\"M\"], d[\"RMSE ens\"], \"o\", color=col, ms=4, label=f\"ens(T), {init}\")\n",
    "            ax.plot(d[\"M\"], d[\"RMSE ens теор.\"], \"-\", color=col, lw=1)\n",
    "            ax.plot(d[\"M\"], d[\"RMSE time\"], \"s\", color=col, ms=4, mfc=\"none\", label=f\"time, {init}\")\n",
    "            ax.plot(d[\"M\"], d[\"RMSE time теор.\"], \"--\", color=col, lw=1)\n",
    "        ax.set_xscale(\"log\")\n",
    "        ax.set_yscale(\"log\")\n",
    "        ax.set_title(f\"θ = {th:g}, T = {Th:g}, θT = {th * Th:g}\")\n",
    "        ax.set_xlabel(\"M\")\n",
    "        ax.set_ylabel(\"RMSE\")\n",
    "axes[0, 0].legend(fontsize=7)\n",
    "fig.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "summary = MU_EST.pivot_table(index=[\"θ\", \"T\", \"начало\"], columns=\"M\", values=\"RMSE ens\")\n",
    "summary.columns = [f\"ens, M={m}\" for m in summary.columns]\n",
    "extra = MU_EST.groupby([\"θ\", \"T\", \"начало\"])[[\"RMSE time\", \"RMSE time теор.\", \"смещение time\", \"смещение time теор.\"]].first()\n",
    "MU_SUMMARY = summary.join(extra)\n",
    "MU_SUMMARY"
   ]
