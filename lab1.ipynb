    "rows, scatter = [], {}\n",
    "for name, p in INC_PROC.items():\n",
    "    inc = INC[name]\n",
    "    pairs = [(f\"{a}–{b}\", inc[a], inc[b], INTERVALS[a], INTERVALS[b]) for a, b in PAIRS]\n",
    "    if name == \"Винер\":\n",
    "        pairs.append((\"контроль: ΔW_A, ΔW_A²\", inc[\"A\"], inc[\"A\"] ** 2, None, None))\n",
    "    else:\n",
    "        a0 = LAM * length(INTERVALS[\"A\"]) + 0.5\n",
    "        pairs.append((\"контроль: ΔN_A, (ΔN_A − a)²\", inc[\"A\"], (inc[\"A\"] - a0) ** 2, None, None))\n",
    "    for label, x, y, I, J in pairs:\n",
    "        r, r_sq, pval, V = dependence(x, y)\n",
    "        rho = 0.0 if I is None else overlap(I, J) / np.sqrt(length(I) * length(J))\n",
    "        rows.append(\n",
    "            {\n",
    "                \"процесс\": name,\n",
    "                \"пара\": label,\n",
    "                \"|I∩J|\": np.nan if I is None else overlap(I, J),\n",
    "                \"ρ теор.\": rho,\n",
    "                \"r\": r,\n",
    "                \"r₂ теор. (гаусс)\": rho**2 if (name == \"Винер\" and I is not None) else np.nan,\n",
    "                \"r₂\": r_sq,\n",
    "                \"χ² p\": pval,\n",
    "                \"Крамер V\": V,\n",
    "                \"независимы (теория)\": \"да\" if (I is not None and overlap(I, J) == 0) else \"нет\",\n",
    "            }\n",
    "        )\n",
    "        scatter[(name, label)] = (x, y)\n",
    "DEP_TABLE = pd.DataFrame(rows).set_index([\"процесс\", \"пара\"])\n",
    "display(DEP_TABLE)\n",
    "\n",
    "fig, axes = plt.subplots(2, 5, figsize=(16, 6.4))\n",
    "jit = np.random.default_rng([SEED, 5])\n",
    "for ax, ((name, label), (x, y)) in zip(axes.ravel(), scatter.items()):\n",
    "    n_pts = 1500\n",
    "    xs, ys = x[:n_pts], y[:n_pts]\n",
    "    if name == \"Пуассон\":\n",
    "        xs = xs + jit.uniform(-0.3, 0.3, n_pts)\n",
    "        ys = ys + jit.uniform(-0.3, 0.3, n_pts)\n",
    "    ax.scatter(xs, ys, s=3, alpha=0.35, color=COLORS[name])\n",
    "    row = DEP_TABLE.loc[(name, label)]\n",
    "    ax.set_title(f\"{name}, {label}\\nr = {row['r']:.2f}, V = {row['Крамер V']:.2f}\", fontsize=8)\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
